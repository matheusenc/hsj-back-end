bin/
obj/
.vs/
.idea/
*.user
*.suo

# Segredos locais — nunca versionar.
# O Development.json sai do controle de versão porque cada máquina aponta para
# um banco diferente (local ou o da VPS) e a senha ficaria commitada. Use
# appsettings.Development.json.example como ponto de partida, ou os user
# secrets: dotnet user-secrets set "ConnectionStrings:DbConnection" "..."
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
.env

# Arquivos enviados pelo admin em ambiente de desenvolvimento.
# A barra inicial ancora a regra na raiz: sem ela o padrao casaria com
# qualquer pasta Storage/ do codigo (o Windows ignora caixa) e o fonte
# ficaria de fora do commit.
/storage/
